# -----------------------------------------------------------------------------
# Variables de entorno de Café Cloud (opcional).
#
# docker-compose.yml ya trae valores por defecto LOCALES para todo, así que el
# sistema arranca sin este archivo. Para personalizar: cp .env.example .env
# (el archivo .env está en .gitignore: nunca se sube al repositorio).
# -----------------------------------------------------------------------------

# --- PostgreSQL (pedidos) ---
POSTGRES_USER=cafe
POSTGRES_PASSWORD=cafe_local_password
POSTGRES_DB=cafe_orders
POSTGRES_PORT=5432

# --- MongoDB (notificaciones) ---
MONGO_USER=cafe
MONGO_PASSWORD=cafe_local_password
MONGO_PORT=27017

# --- Redis (broker) ---
REDIS_PORT=6379

# --- Aplicación ---
LOG_LEVEL=INFO
# Clave exigida en la cabecera X-API-Key. Déjala vacía para desactivar la auth.
API_KEY=cafe-cloud-dev-key

# --- processor-service: simulación de la preparación ---
PROCESSING_MIN_SECONDS=2
PROCESSING_MAX_SECONDS=5
# Probabilidad 0..1 de fallo transitorio simulado (para ver reintentos).
PROCESSING_FAILURE_RATE=0

# --- cleanup-job ---
CLEANUP_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=60
